{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "useUnknownInCatchVariables": false,
    "noEmit": true,
    "types": ["node", "vitest"]
  },
  "include": [
    "src/**/*.ts",
    "demo/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "vite.config.ts",
    "vite.demo.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "build", "dist", "docs"]
}
