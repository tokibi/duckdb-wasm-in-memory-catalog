{
  "name": "duckdb-wasm-in-memory-catalog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "exports": {
    ".": "./src/javascript/in-memory-catalog-controller.mjs",
    "./worker": "./src/javascript/in-memory-catalog-worker.js",
    "./metadata-store": "./src/javascript/in-memory-catalog-metadata-store.js",
    "./worker-runtime": "./src/javascript/in-memory-catalog-worker-runtime.js",
